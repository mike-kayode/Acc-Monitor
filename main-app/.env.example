# NairaTrader Account Pool Monitor - Environment Configuration
# Copy this file to .env and fill in actual values during installation
# NEVER commit .env with real secrets to version control

APP_NAME="NairaTrader Account Monitor"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos
APP_URL=https://your-monitor-domain.com
APP_SECRET_KEY=change_this_to_a_strong_random_string

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=nairatrader_monitor
DB_USERNAME=db_user
DB_PASSWORD=db_password

# Monitoring Configuration
MONITOR_ENABLED=true
MONITOR_INTERVAL=5
WARNING_THRESHOLD=200
CRITICAL_THRESHOLD=100
EMERGENCY_THRESHOLD=50
EXHAUSTION_THRESHOLD=0
MAX_WHATSAPP_RECIPIENTS=5
WHATSAPP_ENABLED=true
REMINDER_INTERVAL_MINUTES=60
CONNECTION_TIMEOUT_SECONDS=15
REQUEST_TIMEOUT_SECONDS=30
EXTRACTION_RETRY_ATTEMPTS=2
NOTIFICATION_RETRY_ATTEMPTS=3
DUPLICATE_ALERT_PREVENTION=true
RECOVERY_NOTIFICATIONS=true

# NairaTrader Target
NAIRATRADER_URL=https://nairatrader.ng/admin/data-mirror?tab=mt5-pool-create

# Internal API Security (shared with WhatsApp worker)
WORKER_SECRET=generate_strong_secret_here
HMAC_SECRET=generate_strong_hmac_secret_here
API_RATE_LIMIT=60

# Telegram Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Session Configuration
SESSION_LIFETIME=3600
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict