# WhatsApp Worker Environment Configuration
# Copy to .env and fill in actual values

NODE_ENV=production
WORKER_PORT=3001
WORKER_HOST=127.0.0.1
SESSION_NAME=nairatrader-monitor
WHATSAPP_AUTH_MODE=qr
WHATSAPP_MAX_RECIPIENTS=5

# Internal API Security (must match main app)
PHP_APP_URL=https://your-monitor-domain.com
WORKER_SECRET=generate_strong_secret_here
HMAC_SECRET=generate_strong_hmac_secret_here

# Session encryption
SESSION_ENCRYPTION_KEY=generate_32_character_encryption_key

# Puppeteer/Chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=false
PUPPETEER_EXECUTABLE_PATH=

# Headless mode (true for server, false for desktop with display)
HEADLESS=true